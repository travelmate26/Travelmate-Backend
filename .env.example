# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESET_PASSWORD_REDIRECT_URL=https://yourapp.com/reset-password

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# VTPass
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_PUBLIC_KEY=your_vtpass_public_key

# Termii SMS
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=Travelmate

# WebSocket (for real-time)
WEBSOCKET_SERVER_URL=wss://your-websocket-server.com

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379
